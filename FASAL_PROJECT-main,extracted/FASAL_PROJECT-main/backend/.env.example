# ==============================================================================
# FASAL BACKEND PRODUCTION CONFIGURATION
# ==============================================================================
# Server Port (default: 8000)
PORT=8000
ENVIRONMENT=production

# Security: Allowed CORS origins (comma-separated, or * for all)
ALLOWED_ORIGINS=http://localhost:5173,https://fasal.netlify.app

# Google Gemini API Key for Multimodal AI Agronomist
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret Key
JWT_SECRET=fasal_production_jwt_secret_key_change_me_2025

# Rate Limiter (requests per minute per IP)
RATE_LIMIT_PER_MIN=120
